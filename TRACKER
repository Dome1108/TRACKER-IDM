# =====================================================
# FILTROS
# =====================================================

if hide_completed:
    df = df[
        ~df["estado"]
        .astype(str)
        .str.lower()
        .str.contains("completo|finalizado", na=False)
    ]

if only_overdue:
    df = df[df["dias_restantes"] < 0]

if search:
    search_lower = search.lower()

    df = df[
        df["proyecto"].astype(str).str.lower().str.contains(search_lower, na=False)
        | df["mini_proyecto"].astype(str).str.lower().str.contains(search_lower, na=False)
        | df["descripcion"].astype(str).str.lower().str.contains(search_lower, na=False)
        | df["encargado"].astype(str).str.lower().str.contains(search_lower, na=False)
    ]


