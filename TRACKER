# =====================================================
# KANBAN POR TIPO
# =====================================================

tipos = list(df["tipo"].dropna().unique())

orden_preferido = [
    "Estudio Recurrente",
    "Estudios Recurrentes",
    "Iniciativa",
    "Iniciativas",
    "Solicitud Interna",
    "Solicitudes Internas",
    "Tendencias"
]

tipos_ordenados = []

for tipo_preferido in orden_preferido:
    for tipo_real in tipos:
        if str(tipo_real).strip().lower() == tipo_preferido.lower():
            if tipo_real not in tipos_ordenados:
                tipos_ordenados.append(tipo_real)

for tipo_real in tipos:
    if tipo_real not in tipos_ordenados:
        tipos_ordenados.append(tipo_real)


if not tipos_ordenados:
    st.warning("No hay proyectos para mostrar con los filtros actuales.")
    st.stop()


# Para no romper la pantalla si aparecen muchas categorías
max_columns = min(len(tipos_ordenados), 5)
cols = st.columns(max_columns)

for idx, tipo in enumerate(tipos_ordenados):
    col = cols[idx % max_columns]

    with col:
        subset = df[df["tipo"] == tipo].copy()

        # Orden dentro de cada columna:
        # 1. Proyectos con fecha
        # 2. Fecha más cercana arriba
        # 3. Sin fecha al final
        subset = subset.sort_values(
            by=["sin_fecha", "fecha_entrega", "avance"],
            ascending=[True, True, True]
        )

        st.markdown(
            f"""
            <div class="kanban-column-title">
                {escape(str(tipo))}
            </div>
            """,
            unsafe_allow_html=True
        )

        if subset.empty:
            st.caption("Sin proyectos")
        else:
            for _, row in subset.iterrows():
                render_project_card(row)
