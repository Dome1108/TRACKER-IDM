total = len(df)

completos = (
    df["estado"]
    .astype(str)
    .str.lower()
    .str.contains("completo|finalizado", na=False)
    .sum()
)

en_proceso = (
    df["estado"]
    .astype(str)
    .str.lower()
    .str.contains("proceso", na=False)
    .sum()
)

planificados = (
    df["estado"]
    .astype(str)
    .str.lower()
    .str.contains("planificado", na=False)
    .sum()
)

vencidos = (df["dias_restantes"] < 0).sum()

